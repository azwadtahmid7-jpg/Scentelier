  --amber:#8A5CE0;--wa:#1B7A4B;--ms:#2B5FD9;--on:#FFFFFF;
  color-scheme:light;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#0E0023;--ink:#EDE8FA;--muted:#A79BC9;--card:#1B0A3A;--line:#3A2766;
    --amber:#BFA9F5;--wa:#2E9E67;--ms:#4C7DF0;color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0E0023;--ink:#EDE8FA;--muted:#A79BC9;--card:#1B0A3A;--line:#3A2766;
  --amber:#BFA9F5;--wa:#2E9E67;--ms:#4C7DF0;color-scheme:dark;
}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Hind Siliguri","Noto Sans Bengali",system-ui,sans-serif;line-height:1.6;font-size:17px}
.wrap{max-width:960px;margin:0 auto;padding:0 20px}
.band{background:#0E0023;color:#EDE8FA}.bandin{display:flex;align-items:center;gap:16px;padding-top:14px;padding-bottom:14px}.bandin img{width:88px;height:88px;border-radius:14px;display:block}.bandin span{font-size:18px;font-weight:600}.lang{margin-left:auto;display:flex;gap:6px}.lang button{background:transparent;border:1px solid #6a5a99;color:#EDE8FA;border-radius:8px;padding:6px 12px;font:inherit;font-size:15px;cursor:pointer}.lang button[aria-pressed="true"]{background:#BFA9F5;color:#0E0023;border-color:#BFA9F5}.lang button:focus-visible{outline:3px solid #BFA9F5;outline-offset:2px}
.hero{padding:36px 0 28px}
h1{font-size:clamp(34px,7vw,60px);line-height:1.15;margin:0 0 14px;font-weight:700;letter-spacing:-.01em;max-width:14em}
.lead{color:var(--muted);max-width:34em;margin:0 0 28px}
.sizes{display:flex;gap:10px;align-items:flex-end;overflow-x:auto;padding:4px 2px 10px}
.size{flex:1 0 76px;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:8px;
  background:var(--card);border:2px solid var(--line);border-radius:14px;padding:14px 8px 12px;
  color:var(--ink);font:inherit;font-weight:600;cursor:pointer;min-height:176px}
.size svg{display:block}
.size[aria-pressed="true"]{border-color:var(--amber);box-shadow:0 0 0 3px color-mix(in srgb,var(--amber) 30%,transparent)}
.size:focus-visible,.btn:focus-visible{outline:3px solid var(--ms);outline-offset:2px}
.hint{color:var(--muted);font-size:15px;margin:6px 0 0}
h2{font-size:26px;margin:40px 0 16px}
.search{width:100%;max-width:420px;padding:11px 14px;border:2px solid var(--line);border-radius:10px;background:var(--card);color:var(--ink);font:inherit;margin:0 0 16px}.search:focus-visible{outline:3px solid var(--ms);outline-offset:2px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;display:flex;flex-direction:column;gap:6px}
.pic{position:relative;aspect-ratio:3/4;border-radius:10px;overflow:hidden;background:color-mix(in srgb,var(--amber) 14%,var(--card));display:flex;align-items:center;justify-content:center;margin-bottom:8px}.pic img{width:100%;height:100%;object-fit:cover;display:block}
.brand{color:var(--muted);font-size:15px;margin:0}
.name{font-size:21px;font-weight:700;margin:0;line-height:1.3}
.notes{color:var(--muted);font-size:15px;margin:0 0 6px}
.price{font-size:26px;font-weight:700;margin:6px 0 10px}
.price small{font-size:15px;font-weight:500;color:var(--muted)}
.btns{display:flex;gap:8px;margin-top:auto}
.btn{flex:1;border:0;border-radius:10px;padding:11px 8px;font:inherit;font-weight:600;color:var(--on);cursor:pointer;text-align:center;text-decoration:none}
.btn.wa{background:var(--wa)}.btn.add{background:var(--ink);color:var(--bg)}
body.hascart{padding-bottom:84px}
.cartbar{position:fixed;left:0;right:0;bottom:0;z-index:20;background:#0E0023;color:#EDE8FA;padding:12px 20px calc(12px + env(safe-area-inset-bottom,0px));border-top:1px solid #3A2766;display:none}
.cartbar.on{display:block}
.cartbar .in{max-width:960px;margin:0 auto;display:flex;align-items:center;gap:12px}
.cartbar .sum{flex:1;font-weight:600}
.cartbar button{background:#BFA9F5;color:#0E0023;border:0;border-radius:10px;padding:11px 18px;font:inherit;font-weight:700;cursor:pointer}
.cartbar button:focus-visible,.panel button:focus-visible,#send:focus-visible{outline:3px solid var(--ms);outline-offset:2px}
.sheet{position:fixed;inset:0;background:rgba(10,0,25,.6);z-index:30;display:flex;align-items:flex-end;justify-content:center}
.sheet[hidden]{display:none}
.panel{background:var(--card);color:var(--ink);width:100%;max-width:560px;max-height:88vh;overflow:auto;border-radius:16px 16px 0 0;padding:18px 18px calc(18px + env(safe-area-inset-bottom,0px))}
.phead{display:flex;justify-content:space-between;align-items:center}
.phead h2{margin:0;font-size:22px}
.phead button{background:none;border:0;color:var(--ink);font-size:22px;cursor:pointer;padding:6px 10px}
.it{display:flex;gap:10px;align-items:center;padding:12px 0;border-bottom:1px solid var(--line)}
.it .nm{flex:1}.it .nm b{display:block;line-height:1.35}.it .nm small{color:var(--muted)}
.qty{display:flex;align-items:center;gap:8px}
.qty button{width:36px;height:36px;border-radius:8px;border:1px solid var(--line);background:var(--bg);color:var(--ink);font:inherit;font-size:20px;cursor:pointer}
.qty span{min-width:20px;text-align:center;font-weight:600}
.tot{display:flex;justify-content:space-between;font-size:20px;margin:16px 0}
#send{display:block;width:100%;font-size:18px;padding:14px}
.note{color:var(--muted);font-size:15px;margin:10px 0 0}
.hero2{background:radial-gradient(900px 420px at 85% -10%,#5B34B8 0%,transparent 60%),radial-gradient(700px 420px at 0% 115%,#8A3FA8 0%,transparent 55%),#0E0023;color:#EDE8FA;padding:40px 0 0}
.hero2{position:relative;overflow:hidden}
.hero2 .wrap{position:relative;z-index:1}
.wm{position:absolute;right:-30px;top:-6px;width:min(520px,72vw);mix-blend-mode:screen;opacity:.6;pointer-events:none;-webkit-mask-image:radial-gradient(closest-side,#000 55%,transparent 100%);mask-image:radial-gradient(closest-side,#000 55%,transparent 100%);animation:fl 9s ease-in-out infinite}
@keyframes fl{50%{transform:translateY(10px)}}
@media (max-width:640px){.wm{opacity:.32;right:-90px;top:20px;width:95vw}}
.chips{display:flex;gap:6px;flex-wrap:wrap;margin:8px 0 2px}
.chip{flex:1 1 auto;min-width:38px;padding:7px 4px;border-radius:8px;border:2px solid var(--line);background:var(--bg);color:var(--ink);font:inherit;font-size:13px;font-weight:600;cursor:pointer}
.chip[aria-pressed="true"]{border-color:var(--amber);background:color-mix(in srgb,var(--amber) 20%,var(--card))}
.chip:focus-visible{outline:3px solid var(--ms);outline-offset:2px}
.vlist{display:grid;gap:10px}
.vr{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px 16px;display:grid;grid-template-columns:1fr auto;gap:8px 14px;align-items:center}
.vr .vt b{display:block;line-height:1.3}.vr .vt small{color:var(--muted)}
.vpct{font-size:22px;font-weight:700}
.bar{grid-column:1/-1;height:10px;border-radius:99px;background:var(--line);overflow:hidden}
.bar i{display:block;height:100%;background:linear-gradient(90deg,#8A5CE0,#E08FE0);border-radius:99px;transition:width .6s}
.vmeta{color:var(--muted);font-size:15px}
.vbtn{background:var(--ink);color:var(--bg);border-radius:10px;padding:9px 18px;font-weight:600;text-decoration:none;text-align:center}
.vbtn:focus-visible{outline:3px solid var(--ms);outline-offset:2px}
.sug{margin-top:16px;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px}
.sug b{display:block;margin-bottom:8px}
.sugrow{display:flex;gap:10px;flex-wrap:wrap}
.sugrow input{flex:1 1 220px;padding:11px 14px;border:2px solid var(--line);border-radius:10px;background:var(--bg);color:var(--ink);font:inherit}
.sugrow input:focus-visible{outline:3px solid var(--ms);outline-offset:2px}
.info,.pol{margin-top:44px}
.cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px;margin:14px 0}
.ic{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px}
.ic b{display:block;font-size:18px;margin-bottom:4px}.ic span{color:var(--muted)}
.ic .big{display:block;font-size:30px;font-weight:700;color:var(--ink);margin:2px 0}
.info p,.pol p{color:var(--muted);max-width:44em}
.eyebrow{color:#BFA9F5;font-weight:600;letter-spacing:.06em;margin:0 0 10px}
.hero2 h1{font-size:clamp(40px,9vw,76px);line-height:1.1;max-width:11em;margin:0 0 16px;background:linear-gradient(90deg,#F6EEFF,#BFA9F5 55%,#F0B6E8);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero2 .lead{color:#CFC6EA;max-width:32em;margin:0 0 24px;font-size:18px}
.slogan{color:#F0B6E8;font-style:italic;font-size:19px;letter-spacing:.02em;margin:-6px 0 22px}
.cta{background:#BFA9F5;color:#0E0023;border:0;border-radius:12px;padding:13px 26px;font:inherit;font-weight:700;font-size:17px;cursor:pointer}
.cta:focus-visible{outline:3px solid #fff;outline-offset:3px}
.ticker{overflow:hidden;border-top:1px solid #3A2766;margin-top:36px;padding:12px 0;background:rgba(255,255,255,.03)}
.track{display:flex;gap:34px;width:max-content;animation:tick 45s linear infinite;color:#BFA9F5;font-weight:600;letter-spacing:.1em;text-transform:uppercase;font-size:14px}
@keyframes tick{to{transform:translateX(-50%)}}
@keyframes tickr{from{transform:translateX(-50%)}to{transform:translateX(0)}}
.track.rev{animation-name:tickr;animation-duration:90s;margin-top:10px;color:#EDE8FA;opacity:.85;text-transform:none;letter-spacing:.04em;font-size:15px}
.pick{margin-top:32px}.pick h2{margin:0 0 12px;font-size:24px}
.sh{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;margin:44px 0 14px}.sh h2{margin:0;font-size:28px}.sub{color:var(--muted)}
.hrow{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;padding:4px 2px 14px}
.hrow .card{flex:0 0 262px;scroll-snap-align:start}
#bestRow .card{border-color:var(--amber)}
.badge{position:absolute;top:8px;left:8px;background:#BFA9F5;color:#0E0023;font-weight:700;font-size:13px;padding:3px 11px;border-radius:99px}
.card{transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-4px);box-shadow:0 12px 28px rgba(60,20,120,.2)}
@media (prefers-reduced-motion:reduce){.bar i{transition:none}.wm{animation:none}.track,.track.rev{animation:none}.card{transition:none}.card:hover{transform:none}}
.how{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:20px;margin-top:40px}
.how h2{margin-top:0;font-size:22px}
.how ol{margin:0;padding-left:22px;color:var(--muted)}
.how li{margin:6px 0}
footer{padding:32px 0 40px;color:var(--muted);font-size:15px}
#toast{position:fixed;left:50%;transform:translateX(-50%);z-index:40;bottom:calc(84px + env(safe-area-inset-bottom,0px));background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:10px;font-size:15px;opacity:0;pointer-events:none;transition:opacity .2s;max-width:90vw}
#toast.show{opacity:1}
@media (prefers-reduced-motion:reduce){#toast{transition:none}}
</style>
