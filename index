var lang = "bn";
try{ var sv = localStorage.getItem("lang"); if(sv === "en" || sv === "bn") lang = sv; }catch(e){}
function t(k){ return T[lang][k]; }
var size = 10, q = "";
function match(p){ return (p.brand + " " + p.name).toLowerCase().indexOf(q) > -1; }
var grid = document.getElementById("grid");
var toast = document.getElementById("toast");
var tt;

function bottle(ml){
  var h = 34 + ml * 2.4, w = 26 + ml * 0.6, nx = w/2;
  var H = h + 28;
  return '<svg width="'+(w+8)+'" height="'+H+'" viewBox="0 0 '+(w+8)+' '+H+'" aria-hidden="true">'+
    '<rect x="'+(nx+4-6)+'" y="0" width="12" height="14" rx="3" fill="var(--ink)"/>'+
    '<rect x="'+(nx+4-3)+'" y="14" width="6" height="8" fill="var(--muted)"/>'+
    '<rect x="4" y="22" width="'+w+'" height="'+h+'" rx="5" fill="none" stroke="var(--ink)" stroke-width="2"/>'+
    '<rect x="6" y="'+(22+h*0.35)+'" width="'+(w-4)+'" height="'+(h*0.65-2)+'" rx="3" fill="var(--amber)" opacity=".85"/>'+
    '</svg>';
}
function money(n){ return "৳" + n.toLocaleString(lang === "bn" ? "bn-BD" : "en-US"); }
function show(t){
  toast.textContent = t; toast.classList.add("show");
  clearTimeout(tt); tt = setTimeout(function(){ toast.classList.remove("show"); }, 3500);
}
function makeCard(p, badge){
  var cs = size, c = document.createElement("article");
  c.className = "card";
  c.innerHTML = '<div class="pic"></div><p class="brand"></p><h3 class="name"></h3>'+
    '<div class="chips" role="group"></div><div class="price"></div>'+
    '<div class="btns"><button type="button" class="btn add"></button></div>';
  c.querySelector(".brand").textContent = p.brand;
  c.querySelector(".name").textContent = p.name;
  var pic = c.querySelector(".pic");
  if(IMGS[p.name]){ var im = document.createElement("img"); im.src = IMGS[p.name]; im.alt = p.brand + " " + p.name; im.loading = "lazy"; pic.appendChild(im); } else { pic.innerHTML = bottle(cs); }
  if(badge){ var b = document.createElement("span"); b.className = "badge"; b.textContent = badge; pic.appendChild(b); }
  var chips = c.querySelector(".chips"), price = c.querySelector(".price");
  chips.setAttribute("aria-label", t("sizeLabel"));
  function paint(){
    price.innerHTML = money(p.p[SIZES.indexOf(cs)]) + ' <small>/ ' + cs + 'ml</small>';
    Array.prototype.forEach.call(chips.children, function(x){ x.setAttribute("aria-pressed", Number(x.getAttribute("data-ml")) === cs ? "true" : "false"); });
  }
  SIZES.forEach(function(ml){
    var x = document.createElement("button");
    x.type = "button"; x.className = "chip"; x.setAttribute("data-ml", ml); x.textContent = ml + "ml";
    x.onclick = function(){ cs = ml; paint(); };
    chips.appendChild(x);
  });
  paint();
  var ab = c.querySelector(".add"); ab.textContent = t("add");
  ab.onclick = function(){ addItem(p, cs); };
  return c;
}
function fillRow(id, names, badgeFn){
  var el = document.getElementById(id); el.innerHTML = "";
  names.forEach(function(n, k){ var p = byName(n); if(p) el.appendChild(makeCard(p, badgeFn(k))); });
  el.parentNode.hidden = !el.children.length;
}
function waLink(txt){ return "https://wa.me/" + WHATSAPP + "?text=" + encodeURIComponent(txt); }
function renderVote(){
  var box = document.getElementById("voteList"); box.innerHTML = "";
  var tot = 0, bn = lang === "bn";
  VOTE.forEach(function(v){ tot += v.v; });
  VOTE.slice().sort(function(a, b){ return b.v - a.v; }).forEach(function(v){
    var pct = tot ? Math.round(v.v * 100 / tot) : 0, row = document.createElement("div");
    row.className = "vr";
    row.innerHTML = '<div class="vt"><b></b><small></small></div><div class="vpct"></div><div class="bar"><i></i></div><span class="vmeta"></span><a class="vbtn" target="_blank" rel="noopener"></a>';
    row.querySelector("b").textContent = v.name;
    row.querySelector("small").textContent = v.brand;
    row.querySelector(".vpct").textContent = nf(pct) + "%";
    row.querySelector(".bar i").style.width = pct + "%";
    row.querySelector(".vmeta").textContent = nf(v.v) + " " + t("votes");
    var a = row.querySelector(".vbtn"); a.textContent = t("voteBtn");
    a.href = waLink(bn ? "আসসালামু আলাইকুম, আমি চাই আপনারা পরবর্তীতে " + v.brand + " " + v.name + " স্টকে আনুন।" : "Hello, I’d like you to stock " + v.brand + " " + v.name + " next.");
    box.appendChild(row);
  });
  updateSug();
}
function updateSug(){
  var inp = document.getElementById("sugIn"), v = inp.value.trim();
  inp.placeholder = t("sugPh"); inp.setAttribute("aria-label", t("sugPh"));
  document.getElementById("sugGo").href = waLink((lang === "bn" ? "আসসালামু আলাইকুম, আমার একটা মতামত আছে: " : "Hello, I have a suggestion: ") + v);
}
document.getElementById("sugIn").oninput = updateSug;
function renderGrid(){
  grid.innerHTML = "";
  PERFUMES.filter(match).forEach(function(p){ grid.appendChild(makeCard(p, NEW.indexOf(p.name) > -1 ? t("new") : "")); });
  fillRow("newRow", NEW, function(){ return t("new"); });
  fillRow("bestRow", BEST, function(k){ return "#" + nf(k + 1); });
}
document.getElementById("q").oninput = function(){ q = this.value.trim().toLowerCase(); renderGrid(); };
function applyLang(){
  document.documentElement.lang = lang;
  document.querySelectorAll("[data-i18n]").forEach(function(el){ el.textContent = t(el.getAttribute("data-i18n")); });
  var qi = document.getElementById("q");
  qi.placeholder = t("search"); qi.setAttribute("aria-label", t("search"));
  document.querySelectorAll(".lang button").forEach(function(b){ b.setAttribute("aria-pressed", b.getAttribute("data-lang") === lang ? "true" : "false"); });
  renderGrid(); renderCart(); renderVote();
}
document.querySelectorAll(".lang button").forEach(function(b){
  b.onclick = function(){ lang = b.getAttribute("data-lang"); try{ localStorage.setItem("lang", lang); }catch(e){} applyLang(); };
});

// ===== Cart =====
var cart = [];
var sheet = document.getElementById("sheet");
function byName(n){ for(var i = 0; i < PERFUMES.length; i++){ if(PERFUMES[i].name === n) return PERFUMES[i]; } }
function lineP(c){ return byName(c.n).p[SIZES.indexOf(c.s)]; }
function nf(v){ return v.toLocaleString(lang === "bn" ? "bn-BD" : "en-US"); }
function saveCart(){ try{ localStorage.setItem("cart", JSON.stringify(cart)); }catch(e){} }
try{
  var cs = JSON.parse(localStorage.getItem("cart") || "[]");
  if(Array.isArray(cs)) cart = cs.filter(function(c){ return c && byName(c.n) && SIZES.indexOf(c.s) > -1 && c.q > 0; });
}catch(e){}
function addItem(p, sz){
  var e = null;
  cart.forEach(function(c){ if(c.n === p.name && c.s === sz) e = c; });
  if(e) e.q++; else cart.push({n:p.name, s:sz, q:1});
  saveCart(); renderCart(); show(t("added"));
}
function cartMsg(){
  var tot = 0, lines = [], bn = lang === "bn";
  cart.forEach(function(c, i){
    var p = byName(c.n), l = lineP(c) * c.q; tot += l;
    lines.push((i + 1) + ". " + p.brand + " " + p.name + " - " + c.s + "ml × " + c.q + " = " + l + (bn ? " টাকা" : " BDT"));
  });
  return (bn ? "আসসালামু আলাইকুম, আমি অর্ডার করতে চাই:\n" : "Hello, I’d like to order:\n") + lines.join("\n") + "\n" + (bn ? "মোট: " + tot + " টাকা" : "Total: " + tot + " BDT");
}
function renderCart(){
  var cnt = 0, tot = 0;
  cart.forEach(function(c){ cnt += c.q; tot += lineP(c) * c.q; });
  document.getElementById("bar").classList.toggle("on", cnt > 0);
  document.body.classList.toggle("hascart", cnt > 0);
  document.getElementById("sum").textContent = nf(cnt) + t("items") + " · " + money(tot);
  if(!cnt) sheet.hidden = true;
  var box = document.getElementById("items"); box.innerHTML = "";
  cart.forEach(function(c, i){
    var p = byName(c.n), row = document.createElement("div");
    row.className = "it";
    row.innerHTML = '<div class="nm"><b></b><small></small></div><div class="qty"><button type="button" class="mi">−</button><span></span><button type="button" class="pl">+</button></div>';
    row.querySelector("b").textContent = p.brand + " " + p.name;
    row.querySelector("small").textContent = c.s + "ml · " + money(lineP(c));
    row.querySelector("span").textContent = nf(c.q);
    var mi = row.querySelector(".mi"), pl = row.querySelector(".pl");
    mi.setAttribute("aria-label", t("dec")); pl.setAttribute("aria-label", t("inc"));
    mi.onclick = function(){ c.q--; if(c.q < 1) cart.splice(i, 1); saveCart(); renderCart(); };
    pl.onclick = function(){ c.q++; saveCart(); renderCart(); };
    box.appendChild(row);
  });
  document.getElementById("tv").textContent = money(tot);
  document.getElementById("send").href = "https://wa.me/" + WHATSAPP + "?text=" + encodeURIComponent(cartMsg());
}
document.getElementById("open").onclick = function(){ sheet.hidden = false; document.getElementById("close").focus(); };
document.getElementById("close").onclick = function(){ sheet.hidden = true; };
sheet.onclick = function(e){ if(e.target === sheet) sheet.hidden = true; };
document.addEventListener("keydown", function(e){ if(e.key === "Escape") sheet.hidden = true; });
(function(){
  var seen = {}, b = [];
  PERFUMES.forEach(function(p){ if(!seen[p.brand]){ seen[p.brand] = 1; b.push(p.brand); } });
  var html = b.map(function(x){ return "<span>" + x.replace(/&/g,"&amp;") + "</span><span>✦</span>"; }).join("");
  document.getElementById("track").innerHTML = html + html;
  var h2 = PERFUMES.map(function(p){ return "<span>" + p.name.replace(/&/g,"&amp;") + "</span><span>✦</span>"; }).join("");
  document.getElementById("track2").innerHTML = h2 + h2;
})();
document.getElementById("cta").onclick = function(){ document.getElementById("new").scrollIntoView({behavior:"smooth"}); };
applyLang();
</script>
</body>
